# Root .gitignore
node_modules/
dist/
build/
.env
.env.local
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# Backend specific
backend/venv/
backend/.venv/
backend/env/
backend/__pycache__/
backend/*.pyc
backend/**/*.pyc
backend/**/*.pkl
backend/uploads/*
!backend/uploads/.gitkeep
backend/data/*.csv
backend/data/*.xlsx
backend/data/*.pdf

# Frontend specific
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.env.local
frontend/.env
frontend/.next/
frontend/out/
frontend/.cache/
